{
  "name": "ai-chat-exporter",
  "version": "2.3.1",
  "private": true,
  "description": "Export AI chat conversations as Markdown or PNG from a browser extension.",
  "homepage": "https://github.com/oustn/ai-chat-exporter#readme",
  "bugs": {
    "url": "https://github.com/oustn/ai-chat-exporter/issues"
  },
  "license": "MIT",
  "author": "oustn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oustn/ai-chat-exporter.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --react-plugin --vitest-plugin --jsx-a11y-plugin src wxt.config.ts vitest.config.ts tailwind.config.ts release.config.mjs",
    "format": "oxfmt src package.json tsconfig.json wxt.config.ts vitest.config.ts tailwind.config.ts components.json README.md CONTRIBUTING.md SECURITY.md .github release.config.mjs",
    "format:check": "oxfmt --check src package.json tsconfig.json wxt.config.ts vitest.config.ts tailwind.config.ts components.json README.md CONTRIBUTING.md SECURITY.md .github release.config.mjs",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "release": "semantic-release"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom-to-image-more": "^3.10.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.4.49",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0"
}
